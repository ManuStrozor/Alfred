{
  "name": "alfred",
  "private": true,
  "scripts": {
    "test":       "jest",
    "test:watch": "jest --watch",
    "test:cov":   "jest --coverage",
    "build":      "terser gas/Alfred.js --compress --mangle --comments false -o gas/Alfred.min.js",
    "test:min":   "cross-env ALFRED_FILE=gas/Alfred.min.js jest",
    "build:test": "npm run build && npm run test:min"
  },
  "devDependencies": {
    "@types/google-apps-script": "^2.0.9",
    "cross-env": "^10.1.0",
    "jest":      "^29.7.0",
    "terser":    "^5.39.0"
  }
}
