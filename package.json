{
  "name": "alfred",
  "private": true,
  "scripts": {
    "test":       "jest",
    "test:watch": "jest --watch",
    "test:cov":   "jest --coverage",
    "build":      "terser gas/Alfred.js --compress --mangle --comments false -o gas/Alfred.min.js",
    "test:min":   "cross-env ALFRED_FILE=gas/Alfred.min.js jest",
    "build:test": "npm run build && npm run test:min",
    "check:client": "node scripts/check-client.mjs",
    "dump:rendered": "node e2e/dump-rendered.mjs",
    "e2e:build":  "node e2e/build-harness.mjs",
    "e2e:serve":  "node e2e/build-harness.mjs && node e2e/serve.mjs",
    "e2e:codegen": "playwright codegen --channel=msedge http://localhost:4317",
    "test:e2e":   "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:cov": "cross-env E2E_COVERAGE=1 playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "monocart-coverage-reports": "^2.12.0",
    "@types/google-apps-script": "^2.0.9",
    "cross-env": "^10.1.0",
    "jest":      "^29.7.0",
    "terser":    "^5.39.0"
  }
}
